<p id="notice"><%= notice %></p>

<h1>Rooms</h1>
<%= link_to 'New Room', new_room_path %>
<%
=begin%>
<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
    <tr>
      <td><%= link_to 'Show', room %></td>
      <td><%= link_to 'Edit', edit_room_path(room) %></td>
      <td><%= link_to 'Destroy', room, method: :delete, data: { confirm: 'Are you sure?' } %></td>
    </tr>
    <% end %>
  </tbody>
</table>
<%
=end%>

<div class="container">
  <div class="row">
    <% @rooms.each do |room| %>
    <div class="col-sm-4">
      <h3><%= room.title %></h3>
      <p>
        <%= room.description %>
      </p>
      <p>
        <%= room.address_line1 %>
      </p>
      <p>
        <%= room.available_at %>
      </p>
      <div style='width: 100%; height:60%; margin:2px auto diplay:inline-block'>
        <%= image_tag(room.image, alt: 'Property Image', style: 'width:100%') %>
      </div>
      <p>
        <span><%= link_to 'Show', room %></span> |
        <span><%= link_to 'Edit', edit_room_path(room) %></span> |
        <span><%= link_to 'Destroy', room, method: :delete, data: { confirm: 'Are you sure?' } %></span>
      </p>
    </div>
    <% end %>
  </div>
</div>

<br>