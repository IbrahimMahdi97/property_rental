<div class="filter-bar">
  <div class="container no-marginLR">
    <div class="row">
      <div class="col-sm-10">
        <p>Location</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Room Price</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Available Date</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Bathroom Type</p>
      </div>
      <div class="col-sm-2">
        <%= link_to 'New Room', new_room_path, class:"add-button" %>
        <!-- Button trigger modal -->

        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModalCenter">
          <i class="fas fa-plus-circle"></i>
        </button>
      </div>
    </div>
  </div>

</div>
<p id="notice"><%= notice %></p>
<%= render 'rooms', room: @room %>