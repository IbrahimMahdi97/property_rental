<div class="filter-bar">
  <div class="container no-marginLR">
    <div class="row">
      <div class="col-sm-6">
        <p>Location</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Room Price</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Available Date</p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        <p>Bathroom Type</p>
      </div>
      <div class="col-sm-6">
        <%= link_to 'New Room', new_room_path, class:"add-button" %>
      </div>
    </div>
  </div>

</div>
<p id="notice"><%= notice %></p>
<div class="container no-marginLR">
  <div class="row">
    <div class="col-sm-11 rooms-cards">
      <div class="container no-marginLR">
        <div class="row cards-cont">
          <% @rooms.each do |room| %>
          <div class="col-sm-3 room-card">
            <div class="room-image">
              <%= image_tag(room.image, alt: 'Property Image', class:"img_preview") %>
            </div>
            <h6>
              <%= room.address_line1 %>
            </h6>
            <p>
              <%= room.title %>
            </p>
            <div class="container no-marginLR">
              <div class="row">
                <div class="col-sm-5">
                  <p class="p-21">
                    Price: <span>$<%= room.price %>/mo</span>
                  </p>
                </div>
                <div class="col-sm-7">
                  <p class="p-22">
                    Availability Date: <span><%= room.available_at %></span>
                  </p>
                </div>
              </div>
            </div>
            <p>
              <span><%= link_to 'Show', room %></span> |
              <span><%= link_to 'Edit', edit_room_path(room) %></span> |
              <span><%= link_to 'Destroy', room, method: :delete, data: { confirm: 'Are you sure?' } %></span>
            </p>
          </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- end col-sm-10 -->
    <div class=" col-sm-1">

    </div>
    <!-- end col-sm-2 -->
  </div>

</div>


<br>