<div class="container no-marginLR">
  <div class="row">
    <div class="col-md-11 col-sm-9 col-7 rooms-cards">
      <div class="container no-marginLR">
        <div class="row cards-cont">
          <% @rooms.each do |room| %>
          <div onclick="toggleRoom(this)" class="col-lg-3 col-md-4 col-sm-11 room-card">
            <%= hidden_field_tag :id, value: room.id %>
            <div class="room-image">
              <%= image_tag(room.image, alt: 'Property Image', class:"img_preview") %>
            </div>
            <h5>
              <%= room.address_line1 %>
            </h5>
            <p class="card-title">
              <%= room.title %>
            </p>
            <div class="container no-marginLR">
              <div class="row">
                <div class="col-lg-5 col-sm-12 col-10 price-wrap">
                  <p class="p-21">
                    Price: <span>$<%= room.price %>/mo</span>
                  </p>
                </div>
                <div class="col-lg-7 col-sm-12 col-12 avail-wrap">
                  <p class="p-22">
                    Availability Date: <span><%= room.available_at %></span>
                  </p>
                </div>
              </div>
            </div>
            <p>
              <span><%= link_to 'Show', room %></span> |
              <span><%= link_to 'Edit', edit_room_path(room) %></span> |
              <span><%= link_to 'Delete', room, method: :delete, data: { confirm: 'Are you sure?' } %></span>
            </p>
          </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- end col-sm-11 -->
  </div>

  <!-- To Be Added -->
  <!-- Modal -->
  <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLongTitle">New Room</h5>
        </div>
        <%
=begin%>
        <div id="rooms-modal-body" class="modal-body">
          <div class="container">
            <div class="row">
              <div class="col-sm-12">
                <%= link_to 'Back', rooms_path, class:"back-tag" %>
                <%= render 'form', room: @room %>
              </div>
            </div>
          </div>
        </div>
        <%
=end%>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary">Save changes</button>
        </div>
      </div>
    </div>
  </div>
  <!-- To Be Added End -->
</div>

<div class="map-wrap">
  <div id="map"></div>
</div>

<script>
  let map;

  function initMap() {
    const myLatLng = {
      lat: 38.990000,
      lng: -180.002331
    }
    map = new google.maps.Map(document.getElementById("map"), {
      center: myLatLng,
      zoom: 3,
    });

    let markers = JSON.parse('<%= raw @hash.to_json%>')
    bounds = new google.maps.LatLngBounds();
    for (var i = 0; i < markers.length; i++) {


      var marker = new google.maps.Marker({
        position: {
          lat: parseFloat(markers[i].lat),
          lng: parseFloat(markers[i].lng)
        },
        title: markers[i].infowindow,
        map: map
      });
    }

    marker.addListener("click", () => {
      infowindow.open(map, marker);
    });


  }
  rooms = JSON.parse('<%= raw @rooms.to_json %>');

  function toggleRoom(r) {
    console.log(map);

    room_id = parseInt(r.children[0].value.slice(-1))
    my_room = rooms.find(room => room.id === room_id)
    room_obj = {
      id: my_room.id,
      latitude: parseFloat(my_room.latitude),
      longitude: parseFloat(my_room.longitude) - 0.020,
      title: my_room.address_line1
    }

    var centerLatLng = new google.maps.LatLng({
      lat: room_obj.latitude,
      lng: room_obj.longitude
    });
    map.setCenter({
      lat: room_obj.latitude,
      lng: room_obj.longitude
    });
    map.setZoom(15);


  }
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBJm1Q2Cu54GTyRoP02uWiCQz1wltLXsKs&callback=initMap&libraries=&v=weekly" async></script>

